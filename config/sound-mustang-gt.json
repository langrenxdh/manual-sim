// Engine sound for the Mustang GT's 5.0 V8 (M12). A cross-plane V8 fires unevenly on each bank, so half and
// quarter orders of the firing frequency carry its burble; a loud, low exhaust. Fields as in engine-sound.json.
{
  "masterGain": 0.75,
  "harmonics": [[0.25, 0.2], [0.5, 0.6], [1, 1.0], [1.5, 0.35], [2, 0.6], [2.5, 0.15], [3, 0.3], [4, 0.15]],
  "loadReferenceNm": 600,
  "idleLoudness": 0.55,
  "loadLoudness": 0.6,
  "loadBrightness": 0.6,
  "lugModulationDepth": 0.7,
  "lugMinOrder": 3,
  "notFiringGain": 0.25,
  "audibleFromRpm": 150,
  "turboGain": 0,
  "turboCutoffHz": 1800,
  "starterGain": 0.25,
  "starterFrequencyHz": 120,
  "parameterSmoothingS": 0.02,
  "belowSpeakerGain": 0.2,
  "lowCutCompensation": 0.6,
  "exhaustRaspGain": 0.16,
  "exhaustRaspCutoffHz": 1200,
  "squealGain": 0.25,
  "squealHz": 1100,
  "squealFullSlipMps": 3,
  "grindGain": 0.55,
  "grindTeeth": 28,
  "grindMinHz": 120,
  "grindMaxHz": 1600
}
