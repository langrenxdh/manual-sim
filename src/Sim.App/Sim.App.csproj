<Project Sdk="Microsoft.NET.Sdk">

  <!-- raylib host: physics thread, 2D dashboard, tuning panel, engine sound.
       Windows-only at runtime; EnableWindowsTargeting lets the solution still build on Linux. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Sim.App</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
    <PackageReference Include="System.Speech" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sim.Core\Sim.Core.csproj" />
    <ProjectReference Include="..\Sim.Input\Sim.Input.csproj" />
    <ProjectReference Include="..\Sim.Training\Sim.Training.csproj" />
  </ItemGroup>

</Project>
