<Project Sdk="Microsoft.NET.Sdk">

  <!-- G29 input adapter: SDL3 joystick polling, pedal calibration and filtering.
       Windows-only at runtime; EnableWindowsTargeting lets the solution still build on Linux. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Sim.Input</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sim.Core\Sim.Core.csproj" />
  </ItemGroup>

</Project>
