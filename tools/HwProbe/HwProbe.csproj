<Project Sdk="Microsoft.NET.Sdk">

  <!-- M0 hardware probe: reads raw G29 axes/buttons and drives force feedback through SDL3.
       Windows-only at runtime; EnableWindowsTargeting lets the solution still build on Linux. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>HwProbe</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
  </ItemGroup>

</Project>
